# Django core settings
SECRET_KEY=change-this-to-a-long-random-secret-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:8003
ENABLE_BROWSABLE_API=False
SERVE_MEDIA=False
MEDIA_ROOT=media

# Frontend / Google services
FRONTEND_URL=http://localhost:3000
GOOGLE_MAP_API_KEY=your_google_maps_api_key_here

# Email configuration
EMAIL_HOST_USER=your_email@example.com
EMAIL_HOST_PASSWORD=your_email_app_password

# Optional: if you later switch to a different database, you can add entries here
# DB_NAME=
# DB_USER=
# DB_PASSWORD=
# DB_HOST=
# DB_PORT=
