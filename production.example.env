# Django
SECRET_KEY=change-me-generate-a-long-random-secret
DEBUG=False
ENABLE_BROWSABLE_API=False

# Hosts and frontend/backend URLs
# For Elastic IP only, use the Elastic IP here. Later add your domain too.
ALLOWED_HOSTS=YOUR_ELASTIC_IP,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://YOUR_ELASTIC_IP
CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOWED_ORIGINS=http://YOUR_FRONTEND_DOMAIN_OR_IP
CORS_ALLOW_CREDENTIALS=True
FRONTEND_URL=http://YOUR_FRONTEND_DOMAIN_OR_IP
SITE_URL=http://YOUR_ELASTIC_IP

# PostgreSQL RDS
USE_POSTGRES=True
POSTGRES_DB=rightroute_prod
POSTGRES_USER=rightroute_admin
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=your-rds-endpoint.us-east-1.rds.amazonaws.com
POSTGRES_PORT=5432
POSTGRES_SSLMODE=require
POSTGRES_CONN_MAX_AGE=60

# S3 media storage
USE_S3=True
AWS_REGION=us-east-1
AWS_S3_REGION_NAME=us-east-1
AWS_STORAGE_BUCKET_NAME=your-rightroute-media-bucket
AWS_LOCATION=media
AWS_QUERYSTRING_AUTH=False
# Optional if later using CloudFront/custom CDN domain for media.
AWS_S3_CUSTOM_DOMAIN=

# Security flags
# Keep SECURE_SSL_REDIRECT False until domain + SSL are live.
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
USE_X_FORWARDED_HOST=True

# Upload limits
SERVE_MEDIA=False
MEDIA_ROOT=/app/media

# Email / SMTP
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-16-character-gmail-app-password
DEFAULT_FROM_EMAIL=RightRoute <your-email@gmail.com>
SERVER_EMAIL=RightRoute <your-email@gmail.com>

# External services
GOOGLE_MAP_API_KEY=your-google-map-api-key
